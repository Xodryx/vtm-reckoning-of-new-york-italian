<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>RonyItalian</AssemblyName>
    <RootNamespace>RonyItalian</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Interop assemblies are generated by BepInEx on the game's first run, so this
         points at the working copy rather than the Steam install. Override with
         -p:GameDir=... to build against a different one. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Users\Rodrigo\Documents\RoNY-game-copy</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" />

    <!-- The game's types are spread across ~155 interop assemblies that reference each
         other freely, so referencing them wholesale is less brittle than listing them. -->
    <Reference Include="$(Interop)\*.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- Never copy references next to the plugin: BepInEx already loads them. -->
    <Reference Update="@(Reference)">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
