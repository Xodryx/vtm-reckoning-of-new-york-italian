{
 "InnerVoices/THEONEVOICE_SHADOWDAY-4": "<gradient=\"VoiceColorGrad\"><i>LE FERITE GUARISCONO, FIONN.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-5": "<gradient=\"VoiceColorGrad\"><i>L’ATTO FINALE.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:23": "<gradient=\"VoiceColorGrad\"><i>LASCIA ANDARE.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:24": "<gradient=\"VoiceColorGrad\"><i>LASCIA ANDARE, FIONN.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:25": "<gradient=\"VoiceColorGrad\"><i>IL CHIEDERE SPETTA A TE.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:26": "<gradient=\"VoiceColorGrad\"><i>LO AVETE FATTO ENTRAMBI, FIONN.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:27": "<gradient=\"VoiceColorGrad\"><i>È COMPIUTO.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:28": "<gradient=\"VoiceColorGrad\"><i>PERCHÉ LE COSE ACCADONO COME ACCADONO, FIONN?</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:34": "<gradient=\"VoiceColorGrad\"><i>LASCIA ANDARE.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:38": "<gradient=\"VoiceColorGrad\"><i>LASCIA ANDARE, FIONN.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:41": "<gradient=\"VoiceColorGrad\"><i>TI BASTA CHIEDERE.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:43": "<gradient=\"VoiceColorGrad\"><i>FIONN…</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:44": "<gradient=\"VoiceColorGrad\"><i>FIONN.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:45": "<gradient=\"VoiceColorGrad\"><i>ANCÒRATI, FIONN.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:46": "<gradient=\"VoiceColorGrad\"><i>IL COLLETTIVO.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:47": "<gradient=\"VoiceColorGrad\"><i>QUI TUTTE LE NOSTRE VOLONTÀ SI INTRECCIANO.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:48": "<gradient=\"VoiceColorGrad\"><i>TI BASTA CHIEDERE, FIONN.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:49": "<gradient=\"VoiceColorGrad\"><i>NON È QUESTA LA DOMANDA.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:50": "<gradient=\"VoiceColorGrad\"><i>NOI SIAMO TE, FIONN.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:51": "<gradient=\"VoiceColorGrad\"><i>SEI IL SEME DA CUI CRESCIAMO DI NUOVO.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:52": "<gradient=\"VoiceColorGrad\"><i>LE PAROLE SONO FRAGILI.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:53": "<gradient=\"VoiceColorGrad\"><i>DEVI VOLERE OLTRE IL VOLERE, SE VUOI CAPIRE.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:54": "<gradient=\"VoiceColorGrad\"><i>DEVI SOGNARE, AGOGNARE, BRAMARE, DESIDERARE.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:55": "<gradient=\"VoiceColorGrad\"><i>DEVI AVERE FAME.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:56": "<gradient=\"VoiceColorGrad\"><i>DEVI METTERE DA PARTE IL TUO IO E DONARTI ALL’UNITÀ.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:57": "<gradient=\"VoiceColorGrad\"><i>E IL CHIEDERE SPETTA A TE.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:58": "<gradient=\"VoiceColorGrad\"><i>PACE…</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:59": "<gradient=\"VoiceColorGrad\"><i>NON CONOSCERAI MAI LA PACE, FIGLIO DI MALKAV.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:60": "<gradient=\"VoiceColorGrad\"><i>FORSE CI SBAGLIAVAMO SUL CORVO.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:61": "<gradient=\"VoiceColorGrad\"><i>IL TUO CAMMINO È TORTUOSO, E HAI SVOLTATO MALE.</i></gradient>",
 "InnerVoices/THEONEVOICE_SHADOWDAY-:62": "<gradient=\"VoiceColorGrad\"><i>MA NOI SIAMO PAZIENTI.</i></gradient>",
 "InnerVoices/VOICES_SYSCOLLAPSE-1": "<i>… lasciala indietro, Paddy… ti rallenterà, quella stronza…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-2": "<i>… clacchete, clac, clacchete, clac…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-3": "<i>… attenti! armi in pugno, soldato!…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-4": "<i>… strappa! lacera! squarcia! sbrana! dissangualo, quel bastardo!…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-5": "<i>… perché fai schifo a fare quel che fai, stronzo…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-6": "<i>… Qaddy, daddy, paddy, waddy…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-7": "<i>… ti morderà, ti sgranocchierà, ti mangerà, ti sbranerà…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-8": "<i>… è andato, andato troppo oltre…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-9": "<i>… arrenditi, mani in alto, stronza!…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:10": "<i>… fin dove puoi spingerti davvero…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:11": "<i>… sbirro buono, sbirro cattivo, sbirro adescato, sbirro morto, morto, morto…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:12": "<i>… morto, morto, morto, morto—</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:13": "<i>… mortale, letale, morto, morì, morente…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:14": "<i>… e se lo mangerà pure lei…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:15": "<i>… che perspicacia del cazzo la tua…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:16": "<i>… ma cosa faresti mai senza di noi…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:17": "<i>… oh, non li lasceremo mai più uscire dalla tua mente…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:18": "<i>… guarda bene, bel ragazzo… quello sarai tu, molto presto…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:19": "<i>… perché ogni volta che ridi muore un marinaio…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:20": "<i>… scappa! scappa e basta, ragazzo! è il portaluce! ti brucerà via come…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:21": "<i>… allontanati da lui!…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:22": "<i>… stagli alla larga, cazzo!…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:23": "<i>… ciarla ciarla chiacchiera sciocca…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:24": "<i>… nero infinito, fioco e scuro…</i>",
 "InnerVoices/VOICES_SYSCOLLAPSE-:28": "<i>… la stai portando nella tana della bestia, e lo sai…</i>"
}
